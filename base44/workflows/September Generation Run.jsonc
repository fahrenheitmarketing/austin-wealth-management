{
  "name": "September Generation Run",
  "description": "One-time run: finishes generating September 2026 content (8 blogs + 20 social posts) and uploads to ClickUp. Idempotent \u2014 skips pieces already generated.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "one_time",
      "cron_expression": null,
      "one_time_date": "2026-08-12T23:00:00Z",
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "september_generation_run",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "generate": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateContentMonth",
            "args": {
              "month": "2026-09"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Generate September content",
            "description": "8 blogs + 20 social posts to ClickUp"
          }
        }
      }
    ]
  }
}