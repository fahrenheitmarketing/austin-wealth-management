{
  "description": "Every 5 minutes, publishes any pending ScheduledPost records whose scheduled_time has passed.",
  "name": "Publish Scheduled Facebook Posts",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "publish_scheduled_facebook_posts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "publish_due": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "publishDueFacebookPosts",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Publish due posts",
            "description": "Posts whose scheduled time has passed"
          }
        }
      }
    ]
  }
}