{
  "name": "SocialPost",
  "type": "object",
  "properties": {
    "platform": {
      "type": "string",
      "enum": [
        "Facebook",
        "LinkedIn",
        "Instagram",
        "Google Business Profile"
      ]
    },
    "publish_date": {
      "type": "string",
      "format": "date"
    },
    "week": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "segment": {
      "type": "string",
      "enum": [
        "HENRYs",
        "Young Adults",
        "Professionals & Executives",
        "Business Owners",
        "Pre-retirees",
        "Retirees",
        "All"
      ]
    },
    "content_type": {
      "type": "string",
      "enum": [
        "Education",
        "Industry commentary",
        "Brand awareness",
        "Blog promotion"
      ],
      "default": "Education"
    },
    "copy": {
      "type": "string"
    },
    "hashtags": {
      "type": "string"
    },
    "disclaimer": {
      "type": "string"
    },
    "image_description": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "alt_text": {
      "type": "string"
    },
    "source_note": {
      "type": "string",
      "description": "Internal note recording the official source for every figure used in the post"
    },
    "change_note": {
      "type": "string",
      "description": "One-line note on what changed in the redraft, shown beside the [REVISED] marker"
    },
    "short_link": {
      "type": "string"
    },
    "brand_pillar": {
      "type": "string",
      "enum": [
        "Education",
        "Advocacy",
        "Systems",
        "Accountability",
        "Adaptation"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "QA Review",
        "Approved for Schedule",
        "Approved for Publish"
      ],
      "default": "Draft"
    },
    "escalated": {
      "type": "boolean",
      "default": false
    },
    "clickup_task_id": {
      "type": "string"
    }
  },
  "required": [
    "platform",
    "segment",
    "topic"
  ]
}